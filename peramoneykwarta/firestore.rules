rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for the 'users' collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for the 'items' collection (your expenses)
    match /items/{itemId} {
      // Allow creating if the authenticated user is the one listed as the owner
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow read, update, delete only if the document belongs to the logged-in user
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Rules for the 'debts' collection
    match /debts/{debtId} {
      // Allow creating if the authenticated user is the one listed as the owner
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow read, update, delete only if the document belongs to the logged-in user
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
